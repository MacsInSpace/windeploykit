# Boot binaries must never be line-ending normalised. A normalised shimx64.efi or
# snponly.efi fails Secure Boot with no useful error at all - a miserable diagnosis.
# (USM handover, 2026-08-21.)
*.efi   binary
*.pxe   binary
*.kpxe  binary
*.wim   binary
*.sdi   binary
*.torrent binary
*.zip   binary
*.tar.gz binary

# Vendored PowerShell modules are redistributed byte-for-byte and their SHA-256
# hashes are pinned in vendor/psmodules.lock.json. Without this a fresh clone
# normalises CRLF and -VerifyOnly fails on the first checkout.
vendor/psmodules/** -text
*.png   binary
*.icns  binary
*.ico   binary
